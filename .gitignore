# Allow-list: nothing is tracked unless un-ignored below. This keeps the patient
# records (data/), the trained models (models/, runs/) and the environment out of
# the repository.
/*

!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt

# Functions of the notebooks
!/utils_prep.py
!/utils_ml.py
!/utils_ilp.py

# Stop codes read by notebook 01 (Feyman et al. 2022, eTable 1)
!/references/

# The four notebooks, committed executed (outputs and figures included)
!/notebooks/
/notebooks/*
!/notebooks/01_data_preparation.ipynb
!/notebooks/02_no_show_prediction.ipynb
!/notebooks/03_service_time_groups.ipynb
!/notebooks/04_scheduling_ilp.ipynb

# Pilot run on 10 % of the consultations (executed notebooks 02 to 04)
!/pilot_10pct/

# Unit tests
!/tests/
__pycache__/
.pytest_cache/

# Conversion of the raw CSV into Parquet chunks
!/scripts/
/scripts/*
!/scripts/csv_to_parquet.py
